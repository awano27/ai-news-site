@echo off
REM ====================================================================
REM Local secrets for the daily-news override (run_daily_override.bat).
REM
REM   1. Copy this file to "secrets.local.bat" in this same folder.
REM   2. Replace the placeholder below with your real NVIDIA NIM key.
REM   3. Save. The override then scores with NVIDIA instead of Ollama.
REM
REM Get a free developer key at https://build.nvidia.com  (keys start nvapi-).
REM secrets.local.bat is gitignored - it is NEVER committed. ASCII only.
REM ====================================================================

REM Replace the whole value with your real key (it must start with "nvapi-").
REM Until then this placeholder does NOT start with nvapi-, so the override
REM safely falls back to Ollama instead of calling NVIDIA with a bad key.
set "NVIDIA_API_KEY=PASTE_YOUR_nvapi-KEY_HERE"

REM Optional model override (default: meta/llama-3.3-70b-instruct)
REM set "NVIDIA_MODEL=meta/llama-3.3-70b-instruct"
