!scripts/build-homepage-latest.js
!scripts/create-day-slide-light.js
# Used by src/auto_collect/collectors/* (transitively imported by the cloud
# fallback workflow). Only the files actually imported are tracked.
!scripts/collectors/
scripts/collectors/*
!scripts/collectors/__init__.py
!scripts/collectors/base.py
!scripts/collectors/rss.py
!scripts/collectors/hn.py

# OG-image cache is machine-local (rebuilt from slide titles on demand).
assets/og/.og-cache.json
tools/
# src/auto_collect/ is the public daily-report pipeline (committed).
# src/generators + src/utils provide the AI-Ranking HTML build (used by
# .github/workflows/build-ranking-preview.yml). Only the files actually
# imported are tracked; everything else under src/ stays local-only.
src/*
!src/__init__.py
!src/auto_collect/
!src/generators/
src/generators/*
!src/generators/__init__.py
!src/generators/slide_generator.py
!src/generators/ranking_report_generator.py
# 2026-06 refactor: god-file split modules (imported by ranking_report_generator.py)
!src/generators/ranking_data_parser.py
!src/generators/ranking_template.py
!src/generators/slide_assets.py
!src/utils/
src/utils/*
!src/utils/__init__.py
!src/utils/sanitize.py
# 2026-06 refactor: shared layer (imported by __init__.py and migrated callers)
!src/utils/encoding.py
!src/utils/dates.py
!src/utils/paths.py
tests/
!tests/
tests/*
!tests/test_auto_collect_main.py
data/
# config/ only tracks analytics.json (GA4 ID is public-safe).
config/*
!config/analytics.json
frontend/
# daily-news/ is generated by src/auto_collect/daily_news_page.py — full feed
# (RSS / arXiv / GitHub / HuggingFace / HN + X bookmarks from the Obsidian vault).
# Tracked so GitHub Pages serves the latest version on visionhub.jp/daily-news/.
daily_slides/
input/
backup_untracked/

